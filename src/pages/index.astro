---
import Base from "../layouts/Base.astro";
import SiteFooter from "../components/SiteFooter.astro";
---

<Base
  title="Kham Udom"
  description="UX engineer specializing in design systems, interactive prototypes, and production software. This site runs on Charm UX, an open-source design system he contributes to."
>
  <main id="main">
    <!-- 01 · key visual: claim + hover-expand anatomy -->
    <section class="horizon" id="top" aria-label="Introduction">
      <div class="wrap horizon-inner">
        <div class="horizon-type">
          <p class="cap claim-kicker">
            <span class="kicker-pair">UX engineer · design systems</span>
            <span class="kicker-pair">prototypes · software</span>
          </p>
          <h1 class="claim">
            I turn design into <em>software</em> that ships.
          </h1>
          <p class="lede">
            I prototype ideas into something you can try, ship full products
            from schema to UI, and build the design systems teams scale on for
            game consoles, browsers, and AI developer platforms.
          </p>
        </div>
        <div
          class="stage"
          tabindex="0"
          aria-label="Exploded diagram of a button as a design system: each layer maps to a design token (elevation shadow, surface, hover state, label, and focus ring). Hover or focus to expand. Open tokens to re-theme it live."
        >
          <div class="stack" aria-hidden="true">
            <div class="layer l-shadow">
              <span class="tag">--button-shadow</span>
            </div>
            <div class="layer l-surface">
              <span class="tag">--button-bg-color</span>
            </div>
            <div class="layer l-state">
              <span class="tag">--button-hover-bg-color</span>
            </div>
            <div class="layer l-label">
              Get started<span class="tag">--button-fg-color</span>
            </div>
            <div class="layer l-focus">
              <span class="tag">--button-focus-shadow</span>
            </div>
          </div>
          <p class="stage-caption">
            fig 1. a design system in one component. every layer is a token.
          </p>
        </div>
      </div>
    </section>

    <!-- 02 · work: featured editorial + proof strip + index (not a card grid) -->
    <section class="band" id="work">
      <div class="wrap">
        <header class="band-head">
          <h2 class="band-title">
            Design systems, prototypes, and software that shipped.
          </h2>
        </header>

        <article class="feature-band product-band">
          <div class="feature-band-copy">
            <p class="org">
              <span>Microsoft CoreAI · systems</span><span>2025-present</span>
            </p>
            <h3>CoreAI Design System</h3>
            <p class="lede-sm">
              A design system for internal Microsoft apps, built on Fluent UI
              v9. I contribute to the React theme package, Storybook, and an
              MCP so humans and agents consume the same components. I also work
              on Microsoft Foundry, and with the Foundry Toolkit extension team
              on <strong>vsc-ui-react</strong>: VS Code-styled components on
              Fluent that ship inside an extension with 1.2M+ installs.
            </p>
            <div class="card-links">
              <a href="https://ai.azure.com/home" target="_blank" rel="noopener"
                >Microsoft Foundry ↗</a
              >
              <a
                href="https://marketplace.visualstudio.com/items?itemName=ms-windows-ai-studio.windows-ai-studio"
                target="_blank"
                rel="noopener">Foundry Toolkit ↗</a
              >
              <a
                href="https://github.com/vuxhub/vsc-ui-react"
                target="_blank"
                rel="noopener">GitHub vsc-ui-react ↗</a
              >
              <a
                href="https://www.npmjs.com/package/vsc-ui-react"
                target="_blank"
                rel="noopener">npm vsc-ui-react ↗</a
              >
            </div>
          </div>
          <div class="feature-band-media">
            <img
              class="product-cover"
              src="/images/foundry.jpg"
              alt="Microsoft Foundry landing page with the headline The AI app and agent factory"
              loading="lazy"
            />
          </div>
        </article>

        <article class="proof-strip">
          <div class="proof-media">
            <img
              class="product-cover"
              src="/images/charm.jpg"
              alt="Charm documentation site with Welcome to Charm heading and View components button"
              loading="lazy"
            />
          </div>
          <div class="proof-copy">
            <p class="org">
              <span>open source · systems</span><span>2023-present</span>
            </p>
            <h3>Charm UX</h3>
            <p class="lede-sm">
              An open-source design system that began as an internal Microsoft
              library and is now public: 30+ accessible, headless Lit web
              components in <strong>@charm-ux/core</strong>, plus
              <strong>@charm-ux/fui</strong> for Fluent-aligned components on
              top.
            </p>
            <div class="card-links">
              <a
                href="https://charm-ux.github.io/core/"
                target="_blank"
                rel="noopener">Charm site ↗</a
              >
              <a
                href="https://github.com/charm-ux/core"
                target="_blank"
                rel="noopener">GitHub @charm-ux/core ↗</a
              >
              <a
                href="https://www.npmjs.com/package/@charm-ux/core"
                target="_blank"
                rel="noopener">npm @charm-ux/core ↗</a
              >
              <a
                href="https://www.npmjs.com/package/@charm-ux/fui"
                target="_blank"
                rel="noopener">npm @charm-ux/fui ↗</a
              >
            </div>
          </div>
        </article>

        <article class="feature-band product-band">
          <div class="feature-band-media">
            <img
              class="product-cover"
              src="/images/athletic.jpg"
              alt="The Athletic Advertising marketing site with sports-elevated hero and mobile ad formats"
              loading="lazy"
            />
          </div>
          <div class="feature-band-copy">
            <p class="org">
              <span>independent · software</span><span>2026</span>
            </p>
            <h3>The Athletic Advertising</h3>
            <p class="lede-sm">
              Production marketing site for The Athletic, part of The New York
              Times: ad formats, specs, and proof pages, from design through
              deploy on Astro SSG and Content Collections.
            </p>
            <div class="card-links">
              <a
                href="https://theathleticadvertising.com/"
                target="_blank"
                rel="noopener">Live site ↗</a
              >
            </div>
          </div>
        </article>

        <ul class="work-index">
          <li class="work-row">
            <img
              class="work-thumb"
              src="/images/recipe-room.jpg"
              alt=""
              loading="lazy"
            />
            <div class="work-row-body">
              <p class="org">
                <span>independent · software</span><span>2025-present</span>
              </p>
              <h3>The Recipe Room</h3>
              <p>
                Full product from schema to live PWA: Postgres data model,
                GPT-4o vision recipe extract, chef assistant, and the cookbook
                UI cooks use. I don't stop at the component layer. I ship the
                app.
              </p>
              <div class="card-links">
                <a href="/work/the-recipe-room" class="case-link"
                  >View project →</a
                >
                <a
                  href="https://www.thereciperoom.net/"
                  target="_blank"
                  rel="noopener">Live site ↗</a
                >
                <a
                  href="https://github.com/khamudom/the-recipe-room"
                  target="_blank"
                  rel="noopener">GitHub ↗</a
                >
              </div>
            </div>
          </li>
          <li class="work-row">
            <img
              class="work-thumb"
              src="/images/edge.jpg"
              alt=""
              loading="lazy"
            />
            <div class="work-row-body">
              <p class="org">
                <span>Microsoft Web Platform · prototype</span><span
                  >2017-2021</span
                >
              </p>
              <h3>Microsoft Edge</h3>
              <p>
                Live prototypes for Vertical Tabs and feature flows, plus FAST /
                Fluent components for Shopping, News, and high-contrast
                DevTools.
              </p>
              <div class="card-links">
                <a href="/work/microsoft-edge" class="case-link"
                  >View project →</a
                >
              </div>
            </div>
          </li>
          <li class="work-row">
            <img
              class="work-thumb"
              src="/images/fast.jpg"
              alt=""
              loading="lazy"
            />
            <div class="work-row-body">
              <p class="org">
                <span>Microsoft Web Platform · systems</span><span
                  >2017-2021</span
                >
              </p>
              <h3>FAST &amp; Fluent UI Web Components</h3>
              <p>
                Open-source contributor: high-contrast work, navigation and
                section-header for fast.design.
              </p>
              <div class="card-links">
                <a href="/work/fast" class="case-link">View project →</a>
                <a href="https://fast.design/" target="_blank" rel="noopener"
                  >fast.design ↗</a
                >
                <a
                  href="https://github.com/microsoft/fast"
                  target="_blank"
                  rel="noopener">GitHub ↗</a
                >
              </div>
            </div>
          </li>
          <li class="work-row">
            <img
              class="work-thumb"
              src="/images/xbox.jpg"
              alt=""
              loading="lazy"
            />
            <div class="work-row-body">
              <p class="org">
                <span>Microsoft Xbox · software</span><span>2012-2017</span>
              </p>
              <h3>Xbox One Dashboard</h3>
              <p>
                Core UI and prototypes across Home, Community, Store, and One
                Guide. XAML/MVVM, 10-foot TV experience through three console
                releases.
              </p>
              <div class="card-links">
                <a href="/work/xbox-dashboard" class="case-link"
                  >View project →</a
                >
              </div>
            </div>
          </li>
        </ul>
      </div>
    </section>

    <!-- 03 · approach: manifesto stack, not three equal cards -->
    <section class="band band-deep" id="approach">
      <div class="wrap manifesto-wrap">
        <header class="band-head manifesto-head">
          <h2 class="band-title">Prototype. Ship. Systematize.</h2>
        </header>
        <ol class="manifesto">
          <li>
            <span class="manifesto-tag">prototype</span>
            <div>
              <h3>Live builds beat static designs</h3>
              <p>
                Nine years building 3D game worlds taught me to make things you
                can walk through. Code a rough live version, try it, then harden
                what works into production.
              </p>
            </div>
          </li>
          <li>
            <span class="manifesto-tag">product</span>
            <div>
              <h3>I ship the app, not just the components</h3>
              <p>
                Schema, API, UI, deploy. I've taken apps from first sketch to a
                live URL (The Recipe Room, Athletic Advertising) and built
                platform UI at Microsoft that millions of people use.
              </p>
            </div>
          </li>
          <li>
            <span class="manifesto-tag">a11y</span>
            <div>
              <h3>Don't bolt accessibility on later</h3>
              <p>
                Keyboard, screen reader, and high contrast from the start. I've
                done the WCAG and ARIA cleanup from Edge to CoreAI.
              </p>
            </div>
          </li>
          <li>
            <span class="manifesto-tag">systems</span>
            <div>
              <h3>Other developers are the users</h3>
              <p>
                Clear API, predictable behavior, real examples. Get that right
                and teams adopt. Get it wrong and they build workarounds.
              </p>
            </div>
          </li>
        </ol>
      </div>
    </section>

    <!-- 04 · experience: compact timeline -->
    <section class="band" id="experience">
      <div class="wrap">
        <header class="band-head">
          <h2 class="band-title">From game worlds to products and systems.</h2>
        </header>
        <ol class="timeline">
          <li>
            <span class="yr">2025+</span>
            <div>
              <span class="role">UX Engineer · Microsoft CoreAI</span>
              <div class="org2">CoreAI design system · contract</div>
              <p class="desc">
                Theme package on Fluent UI v9 for internal Microsoft apps;
                Microsoft Foundry, Foundry Toolkit, Storybook, MCP, and
                accessibility.
              </p>
            </div>
          </li>
          <li>
            <span class="yr">2023</span>
            <div>
              <span class="role"
                >Software Engineer · Microsoft C+E CX Studio</span
              >
              <div class="org2">Charm UX design system · contract</div>
              <p class="desc">
                Core components for Charm UX: @charm-ux/core and
                @charm-ux/fui, headless Lit components with design-token
                theming.
              </p>
            </div>
          </li>
          <li>
            <span class="yr">2022</span>
            <div>
              <span class="role">Independent Software Engineer</span>
              <div class="org2">Client products, concept → deployment</div>
              <p class="desc">
                Accessible, performant web applications built in direct
                partnership with clients.
              </p>
            </div>
          </li>
          <li>
            <span class="yr">2021</span>
            <div>
              <span class="role">UX Engineer · Microsoft Web Prototyping</span>
              <div class="org2">Concept → working software</div>
              <p class="desc">
                Interactive prototypes for early product decisions. Live builds
                over static mocks so stakeholders could try the idea.
              </p>
            </div>
          </li>
          <li>
            <span class="yr">2017</span>
            <div>
              <span class="role">UX Engineer · Microsoft Web Platform</span>
              <div class="org2">FAST · Fluent UI · Edge</div>
              <p class="desc">
                Core components for Edge, News, and Shopping; accessibility and
                UI performance initiatives.
              </p>
            </div>
          </li>
          <li>
            <span class="yr">2012</span>
            <div>
              <span class="role">Design Developer · Microsoft Xbox</span>
              <div class="org2">Xbox Dashboard</div>
              <p class="desc">
                Core UI and prototypes for the Xbox One Dashboard across the
                2013 launch and the 2015 and 2017 releases.
              </p>
            </div>
          </li>
          <li>
            <span class="yr">2002</span>
            <div>
              <span class="role"
                >3D Environment Artist · Amaze Entertainment</span
              >
              <div class="org2">Cross-platform games</div>
              <p class="desc">
                Nine years building detailed 3D worlds and interactive assets.
                That craft still shapes how I build interfaces.
              </p>
            </div>
          </li>
        </ol>
      </div>
    </section>

    <!-- 05 · skills: two-column catalog, not badge soup alone -->
    <section class="band band-deep" id="skills">
      <div class="wrap">
        <header class="band-head">
          <h2 class="band-title band-title-sm">What I bring to a team.</h2>
        </header>
        <dl class="catalog">
          <div class="catalog-row">
            <dt>languages</dt>
            <dd>TypeScript · JavaScript · HTML · CSS</dd>
          </div>
          <div class="catalog-row">
            <dt>frameworks</dt>
            <dd>React · Next.js · Lit · FAST · Astro · Web Components</dd>
          </div>
          <div class="catalog-row">
            <dt>software</dt>
            <dd>
              End-to-end delivery · Schema → UI · PWAs · Content Collections ·
              Production deploys
            </dd>
          </div>
          <div class="catalog-row">
            <dt>systems</dt>
            <dd>
              Design systems · Design tokens · Fluent UI · Material UI ·
              Storybook · Component architecture
            </dd>
          </div>
          <div class="catalog-row">
            <dt>prototyping</dt>
            <dd>
              Interactive prototypes · Live builds · Three.js · GSAP · Concept
              validation
            </dd>
          </div>
          <div class="catalog-row">
            <dt>accessibility</dt>
            <dd>WCAG · WAI-ARIA · High contrast · Performance optimization</dd>
          </div>
          <div class="catalog-row">
            <dt>ai development</dt>
            <dd>
              Cursor · GitHub Copilot · LLM integrations · Prompt engineering
            </dd>
          </div>
          <div class="catalog-row">
            <dt>platforms</dt>
            <dd>
              Azure DevOps · Google Cloud · Supabase · Postgres · Vercel ·
              Netlify
            </dd>
          </div>
        </dl>
      </div>
    </section>
  </main>
  <SiteFooter />
</Base>
